<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wallet Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
   
    <style>
        :root {
            --primary-gradient: linear-gradient(120deg, #6366f1 0%, #4f46e5 100%);
            --secondary-gradient: linear-gradient(120deg, #34d399 0%, #059669 100%);
            --danger-gradient: linear-gradient(120deg, #f87171 0%, #dc2626 100%);
        }

        body {
            background-color: #f1f5f9;
            min-height: 100vh;
        }

        .dashboard-header {
            background: var(--primary-gradient);
            padding: 2rem 0;
            margin-bottom: -4rem;
            color: white;
        }

        .stat-card {
            border: none;
            border-radius: 16px;
            transition: all 0.3s ease;
            background: white;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .balance-card {
            background: var(--primary-gradient);
            color: white;
        }

        .credit-card {
            background: var(--secondary-gradient);
            color: white;
        }

        .debit-card {
            background: var(--danger-gradient);
            color: white;
        }

        .transaction-item {
            border-left: 4px solid transparent;
            transition: all 0.3s ease;
            padding: 1.5rem;
            margin-bottom: 1rem;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .transaction-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .transaction-item.credit {
            border-left-color: #34d399;
        }

        .transaction-item.debit {
            border-left-color: #f87171;
        }

        .transaction-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin-right: 1rem;
        }

        .transaction-icon.credit {
            background-color: rgba(52, 211, 153, 0.1);
            color: #34d399; /* Green icon for credit */
        }

        .transaction-icon.debit {
            background-color: rgba(248, 113, 113, 0.1);
            color: #f87171; /* Red icon for debit */
        }

        .transaction-details {
            flex-grow: 1;
        }

        .transaction-details h6 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            word-break: break-word; /* Ensure long descriptions don't overflow */
        }

        .transaction-details p {
            font-size: 0.9rem;
            color: #6b7280;
            margin-bottom: 0.25rem;
            word-break: break-word; /* Ensure long types don't overflow */
        }

        .transaction-details small {
            font-size: 0.8rem;
            color: #9ca3af;
        }

        .amount-badge {
            border-radius: 12px;
            padding: 8px 16px;
            font-weight: 600;
            font-size: 1rem;
            background-color: rgba(52, 211, 153, 0.1);
            color: #059669;
            white-space: nowrap; /* Prevent amount from breaking into multiple lines */
            margin-left: 1rem; /* Add spacing between details and amount */
        }

        .amount-badge.debit {
            background-color: rgba(248, 113, 113, 0.1);
            color: #dc2626;
        }

        .quick-action-card {
            border: 2px dashed #e2e8f0;
            border-radius: 16px;
            transition: all 0.3s ease;
        }

        .quick-action-card:hover {
            border-color: #6366f1;
            background-color: #f8fafc;
        }

        .pagination-container {
            margin-top: 2rem;
        }

        .page-link {
            border-radius: 8px;
            margin: 0 4px;
            padding: 8px 16px;
            color: #6366f1;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }

        .page-link:hover {
            background-color: #6366f1;
            color: white;
            border-color: #6366f1;
        }

        .page-item.active .page-link {
            background-color: #6366f1;
            border-color: #6366f1;
        }

        .page-item.disabled .page-link {
            background-color: #f8fafc;
            border-color: #e2e8f0;
        }

        /* Responsive Styles */
        @media (max-width: 764px) {
            .transaction-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .transaction-item .amount-badge {
                margin-top: 10px;
                align-self: flex-end; /* Align amount to the right on smaller screens */
                margin-left: 0; /* Remove left margin on smaller screens */
            }

            .transaction-details h6 {
                font-size: 1rem; /* Smaller font size for description on mobile */
            }

            .transaction-details p {
                font-size: 0.85rem; /* Smaller font size for type on mobile */
            }

            .pagination {
                flex-wrap: wrap;
                justify-content: center;
            }

            .page-item {
                margin: 4px;
            }

            .page-link {
                padding: 6px 12px;
                font-size: 14px;
            }

            .pagination-container {
                margin-top: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Dashboard Header -->
    <%- include('../partials/user/navbar.ejs') %>

    <div class="container py-5" style="margin-top: 100px;">
        <div class="row gy-4">
            <!-- Stats Cards Row -->
            <div class="col-md-4">
                <div class="stat-card balance-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="opacity-75">Total Balance</h5>
                        <i class="fas fa-coins fa-2x opacity-50"></i>
                    </div>
                    <h2 class="mb-0 fw-bold">₹<%= wallet.balance.toFixed(2) %></h2>
                    <p class="mt-2 mb-0 opacity-75">Available Funds</p>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="col-12">
                <div class="row g-4">
                    <div class="col-md-6">
                        <a href="#" id="addMoneyBtn" class="text-decoration-none">
                            <div class="quick-action-card p-4 text-center">
                                <i class="fas fa-plus-circle fa-3x text-primary mb-3"></i>
                                <h4>Add Money</h4>
                                <p class="text-muted mb-0">Top up your wallet easily</p>
                            </div>
                        </a>
                    </div>
                    
                    <% if (user) { %>
                        <input type="hidden" id="userId" value="<%= user._id %>">
                    <% } %>
                </div>
            </div>

            <!-- Recent Transactions -->
            <div class="col-12">
                <div class="stat-card p-4">
                    <h3 class="mb-4">Recent Transactions</h3>
            
                    <% if (wallet.transactions && wallet.transactions.length > 0) { %>
                        <div class="transaction-list">
                            <% wallet.transactions.slice(0, 5).forEach(txn => { %>
                                <div class="transaction-item <%= txn.type %> p-3 mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="transaction-icon <%= txn.type === 'Credit' ? 'credit' : 'Debit' %>">
                                            <% if (txn.type === 'Credit') { %>
                                                <i class="fas fa-arrow-circle-down fa-2x"></i> <!-- Green icon for credit -->
                                            <% } else { %>
                                                <i class="fas fa-arrow-circle-up fa-2x"></i> <!-- Red icon for debit -->
                                            <% } %>
                                        </div>
                                        <div class="transaction-details">
                                            <h6><%= txn.description %></h6>
                                            <p><%= txn.type %></p>
                                            <small>
                                                <i class="far fa-clock me-1"></i>
                                                <%= new Date(txn.createdAt).toLocaleString() %>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="amount-badge <%= txn.type %>">
                                        ₹<%= txn.amount.toFixed(2) %>
                                    </div>
                                </div>
                            <% }) %>
            
                            <div class="pagination-container d-flex justify-content-center">
                                <nav aria-label="Transaction navigation">
                                    <ul class="pagination">
                                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                            <a class="page-link" href="?page=<%= currentPage - 1 %>" <%= currentPage === 1 ? 'tabindex="-1" aria-disabled="true"' : '' %>>
                                                <i class="fas fa-chevron-left"></i>
                                            </a>
                                        </li>
            
                                        <% for(let i = 1; i <= totalPages; i++) { %>
                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                                            </li>
                                        <% } %>
            
                                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                            <a class="page-link" href="?page=<%= currentPage + 1 %>" <%= currentPage === totalPages ? 'tabindex="-1" aria-disabled="true"' : '' %>>
                                                <i class="fas fa-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="fas fa-receipt fa-4x text-muted mb-3"></i>
                            <h5 class="text-muted">No transactions yet</h5>
                            <p class="text-muted mb-0">Start by adding money to your wallet</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Back to Dashboard -->
            <div class="col-12 text-center">
                <a href="/user/profile" class="btn btn-secondary action-button">
                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <%- include('../partials/user/footer.ejs') %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById("addMoneyBtn").addEventListener("click", async () => {
    try {
        const { value: amount } = await Swal.fire({
            title: "Enter Amount",
            input: "number",
            inputAttributes: {
                min: "1",
                step: "1"
            },
            showCancelButton: true,
            confirmButtonText: "Proceed",
            cancelButtonText: "Cancel",
            inputValidator: (value) => {
                if (!value || isNaN(value) || value <= 0) {
                    return "Please enter a valid amount!";
                }
            }
        });

        if (!amount) return; // If user cancels

        const userId = document.getElementById("userId")?.value; // Fetch userId from hidden input

        if (!userId) {
            Swal.fire("Error", "User ID not found. Please log in again.", "error");
            return;
        }

        Swal.fire({
            title: "Processing...",
            text: "Creating your order...",
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        const orderRes = await fetch("/user/add-money", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ amount })
        });

        const orderData = await orderRes.json();
        Swal.close();

        if (!orderData.success) {
            Swal.fire("Error", "Error creating order!", "error");
            return;
        }

        const { order, razorpayKey } = orderData;
        console.log(order);

        const rzp = new Razorpay({
            key: razorpayKey,
            amount: order.amount,
            currency: "INR",
            order_id: order.id,
            handler: async function (response) {
                Swal.fire({
                    title: "Verifying Payment...",
                    text: "Please wait...",
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const verifyRes = await fetch("/user/verify-payment", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature,
                        amount: amount,
                        userId: userId
                    })
                });

                const verifyData = await verifyRes.json();
                Swal.close();

                if (verifyData.success) {
                    Swal.fire("Success", "Amount successfully added!", "success").then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire("Error", "Payment verification failed!", "error");
                }
            },
            modal: {
                escape: false,
                ondismiss: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Payment Failed!",
                        text: "You exited the payment process. Please try again.",
                        confirmButtonText: "OK"
                    });
                }
            }

        });

        rzp.open();
    } catch (error) {
        console.error("Error:", error);
        Swal.fire("Error", "Something went wrong!", "error");
    }
});
    </script>
</body>
</html>