<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product View Page</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        :root {
            --primary-color: black;
            --secondary-color: #2ecc71;
            --accent-color: #e74c3c;
        }

        body {
            background-color: #f8f9fa;
        }

        .product-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 0 20px rgba(0,0,0,0.05);
            padding: 30px;
        }

        .product-image {
            border-radius: 15px;
            overflow: hidden;
            position: relative;
        }

        .product-image:hover {
            transform: scale(1.05);
            transition: transform 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .carousel-item img {
            object-fit: cover;
            width: 100%;
            height: 100%;
        }

        .size-btn {
            width: 45px;
            height: 45px;
            margin: 5px;
            border: 2px solid #eee;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: bold;
            color: #666;
        }

        .size-btn:hover {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
            transform: translateY(-2px);
        }

        .size-btn.active {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

        .quantity-input {
            width: 100px;
            border-radius: 25px;
            text-align: center;
            border: 2px solid #eee;
            padding: 8px;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
        }

        .btn-custom {
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .btn-buy-now {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            color: white;
            width: auto;
        }

        .btn-buy-now:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(52, 152, 219, 0.3);
        }

        .btn-add-cart {
            background: white;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }

        .btn-add-cart:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
        }

        .product-price {
            font-size: 2rem;
            color: var(--primary-color);
            font-weight: bold;
        }

        .original-price {
            text-decoration: line-through;
            color: #6c757d;
            font-size: 1.2rem;
        }

        .discount-badge {
            background: var(--accent-color);
            color: white;
            padding: 5px 15px;
            border-radius: 25px;
            font-size: 0.9rem;
            margin-left: 10px;
        }

        .feature-badge {
            background: #f8f9fa;
            border-radius: 20px;
            padding: 10px 20px;
            margin: 5px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            color: #666;
        }

        .feature-badge i {
            color: var(--primary-color);
        }

        .thumbnail-container {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .thumbnail:hover {
            transform: scale(1.1);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .product-title {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 20px;
            color: #2c3e50;
        }

        .stock-status {
            color: var(--secondary-color);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 20px;
        }

        .related-product {
            border-radius: 15px;
            overflow: hidden;
            border: none;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .related-product:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .carousel-inner {
            position: relative;
            width: 500px;
            overflow: hidden;
        }

        .zoom-image {
            width: 100%;
            transition: transform 0.1s ease-in-out;
        }

        .carousel-item {
            height: 500px;
        }

        .carousel-caption {
            padding: 1.5rem;
            border-radius: 10px;
            animation: fadeInUp 1s ease;
        }

        .buy-now-form {
            text-align: center;
            margin-top: 15px;
            position: absolute;
            top: 665px;
            left: 1000px;
        }

        .buy-now-btn {
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            color: white;
            font-size: 18px;
            font-weight: bold;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(255, 75, 43, 0.4);
            transition: all 0.3s ease-in-out;
        }

        .buy-now-btn:hover {
            background: linear-gradient(45deg, #ff4b2b, #ff416c);
            transform: scale(1.05);
            box-shadow: 0 8px 20px rgba(255, 75, 43, 0.6);
        }

        .buy-now-btn i {
            margin-right: 8px;
        }

        .selected-size {
            background-color: #ff5733;
            color: white;
            border: 2px solid #ff5733;
        }

        .breadcrumb {
            list-style: none;
            display: flex;
            gap: 8px;
            font-size: 14px;
            padding: 10px 0;
        }

        .breadcrumb li {
            display: flex;
            align-items: center;
        }

        .breadcrumb li a {
            text-decoration: none;
            color: #007bff;
            font-weight: 500;
            transition: color 0.3s ease-in-out;
        }

        .breadcrumb li a:hover {
            color: #0056b3;
        }

        .breadcrumb li::after {
            content: "›";
            margin: 0 8px;
            color: #666;
        }

        .breadcrumb li:last-child::after {
            content: "";
        }

        /* Responsive Adjustments */
        @media (max-width: 1200px) {
            .carousel-inner {
                width: 100%;
            }

            .buy-now-form {
                left: auto;
                right: 20px;
            }
        }

        @media (max-width: 991px) {
            .product-container {
                padding: 20px;
            }

            .product-title {
                font-size: 2rem;
            }

            .carousel-item {
                height: 400px;
            }

            .product-price {
                font-size: 1.8rem;
            }

            .size-btn {
                width: 40px;
                height: 40px;
            }

            .thumbnail {
                width: 70px;
                height: 70px;
            }

            .buy-now-form {
                position: static;
                margin-top: 20px;
            }
        }

        @media (max-width: 767px) {
            .action-buttons {
                flex-direction: column;
                gap: 10px;
            }

            .btn-custom {
                width: 100%;
                padding: 10px 20px;
            }

            .carousel-item {
                height: 300px;
            }

            .product-title {
                font-size: 1.5rem;
            }

            .product-price {
                font-size: 1.5rem;
            }

            .original-price {
                font-size: 1rem;
            }

            .feature-badge {
                padding: 8px 15px;
                font-size: 0.8rem;
            }

            .thumbnail-container {
                justify-content: center;
            }

            .related-product {
                margin-bottom: 15px;
            }
        }

        @media (max-width: 575px) {
            .product-container {
                padding: 15px;
            }

            .carousel-item {
                height: 200px;
            }

            .product-title {
                font-size: 1.2rem;
            }

            .product-price {
                font-size: 1.3rem;
            }

            .size-btn {
                width: 35px;
                height: 35px;
                font-size: 12px;
            }

            .thumbnail {
                width: 50px;
                height: 50px;
            }

            .feature-badge {
                display: block;
                margin: 5px 0;
                text-align: center;
            }

            .breadcrumb {
                font-size: 12px;
                flex-wrap: wrap;
            }

            .buy-now-btn {
                font-size: 16px;
                padding: 10px 15px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/user/navbar.ejs') %>
    <div class="container" style="margin-top: 100px;">
        <ul class="breadcrumb">
            <% breadcrumbs.forEach(breadcrumb => { %>
                <li><a href="<%= breadcrumb.url %>"><%= breadcrumb.name %></a></li>
            <% }) %>
        </ul>
    </div>
    
    <div class="container py-5" style="margin-top: -30px;">
        <div class="product-container">
            <div class="row mb-5">
                <div class="col-md-6">
                    <% if (product.images.length > 0) { %>
                        <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                <% product.images.forEach((image, index) => { %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                        <img src="<%= image %>" alt="Product Image <%= index + 1 %>" class="d-block w-100 zoom-image">
                                    </div>
                                <% }); %>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    <% } else { %>
                        <p>No images available</p>
                    <% } %>
                </div>

                <div class="col-md-6">
                    <h2 class="product-title"><%= product.name %></h2>
                    <div class="stock-status">
                        <i class="fas fa-check-circle"></i> In Stock <%= product.totalStock %>
                    </div>
                    
                    <div class="mb-4">
                        <span class="product-price">
                            <% if (product.isOfferActive) { %>
                                <% if (product.offerType === "product") { %>
                                    ₹<%= product.Offerprice %>
                                <% } else if (product.offerType === "category") { %>
                                    ₹<%= product.price - (product.price * product.discountPercentage / 100) %>
                                <% } %>
                            <% } else { %>
                                ₹<%= product.price %>
                            <% } %>
                        </span>
                        <span class="original-price ms-2">₹<%= product.price %></span>
                        <% if (product.isOfferActive) { %>
                            <span class="discount-badge"><%= product.discountPercentage %> % offer</span>
                        <% } %>
                    </div>

                    <% if (avgRating && avgRating !== "No ratings yet") { %>
                        <div class="product-rating d-flex align-items-center">
                            <% let rating = Math.round(avgRating); %>
                            <% for (let i = 1; i <= 5; i++) { %>
                                <% if (i <= rating) { %>
                                    <i class="fas fa-star text-warning"></i>
                                <% } else { %>
                                    <i class="far fa-star text-warning"></i>
                                <% } %>
                            <% } %>
                        </div>
                    <% } %>

                    <div class="features mb-4">
                        <div class="feature-badge"><i class="fas fa-tshirt"></i> Premium Quality</div>
                        <div class="feature-badge"><i class="fas fa-shipping-fast"></i> Fast Delivery</div>
                        <div class="feature-badge"><i class="fas fa-sync"></i> Easy Returns</div>
                    </div>

                    <form id="add-to-cart-form" action="/user/add-to-cart" method="POST">
                        <input type="hidden" name="productId" value="<%= product._id %>">
                        <div class="mb-4">
                            <h5 class="fw-bold">Select Size</h5>
                            <div class="size-buttons d-flex gap-2">
                                <% if (product.sizeS > 0) { %>
                                    <input type="radio" name="size" value="S" id="sizeS" class="d-none">
                                    <label for="sizeS" class="size-btn">S</label>
                                <% } %>
                                <% if (product.sizeM > 0) { %>
                                    <input type="radio" name="size" value="M" id="sizeM" class="d-none">
                                    <label for="sizeM" class="size-btn">M</label>
                                <% } %>
                                <% if (product.sizeL > 0) { %>
                                    <input type="radio" name="size" value="L" id="sizeL" class="d-none">
                                    <label for="sizeL" class="size-btn">L</label>
                                <% } %>
                                <% if (product.sizeXL > 0) { %>
                                    <input type="radio" name="size" value="XL" id="sizeXL" class="d-none">
                                    <label for="sizeXL" class="size-btn">XL</label>
                                <% } %>
                                <% if (product.sizeXXL > 0) { %>
                                    <input type="radio" name="size" value="XXL" id="sizeXXL" class="d-none">
                                    <label for="sizeXXL" class="size-btn">XXL</label>
                                <% } %>
                            </div>
                        </div>

                        <div class="mb-3" style="display: none;">
                            <label for="quantity" class="fw-bold">Quantity</label>
                            <input type="number" name="quantity" id="quantity" class="form-control" value="1" min="1">
                        </div>

                        <button type="submit" class="btn btn-custom btn-add-cart">
                            <i class="fas fa-plus me-2"></i> Add to Cart
                        </button>
                    </form>

                    <form onsubmit="a(event)">
                        <input type="hidden" name="productId" value="<%= product._id %>">
                        <input type="hidden" name="quantity" value="1">
                        <input type="hidden" name="size" id="hh">
                        <input type="hidden" name="price" value="<%= product.price %>">
                        <button type="submit" class="btn buy-now-btn" style="position: relative; left: 240px; top: -52px; display: none;">
                            <i class="fas fa-shopping-cart"></i> Buy Now
                        </button>
                    </form>
                </div>
            </div>

            <div class="row mt-5">
                <h3 class="mb-4 fw-bold">Others Also Bought</h3>
                <% for (let i = 0; i < simProducts.length; i++) { %>
                    <div class="col-md-3 col-6 mb-4">
                        <div class="card related-product">
                            <a href="/user/productview/<%= simProducts[i]._id %>">
                                <img src="<%= simProducts[i].images[0] %>" class="card-img-top" alt="Related Product 1">
                            </a>
                            <div class="card-body">
                                <h6 class="card-title fw-bold"><%= simProducts[i].name %></h6>
                                <p class="card-text text-primary fw-bold mb-0">₹<%= simProducts[i].price %></p>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <%- include('../partials/user/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
document.addEventListener("DOMContentLoaded", function() {
    const sizeLabels = document.querySelectorAll(".size-btn");
    const addToCartForm = document.getElementById("add-to-cart-form");
    const buyNowForm = document.querySelector('form[onsubmit="a(event)"]');
    const zoomImages = document.querySelectorAll(".zoom-image");

    initializeSizeSelection();
    initializeAddToCart();
    initializeBuyNow();
    initializeImageZoom();

    function initializeSizeSelection() {
        sizeLabels.forEach(label => {
            label.addEventListener("click", function() {
                sizeLabels.forEach(l => l.classList.remove("selected-size"));
                this.classList.add("selected-size");
                const radioId = this.getAttribute("for");
                document.getElementById(radioId).checked = true;
            });
        });
    }

    function initializeAddToCart() {
        if (!addToCartForm) return;

        addToCartForm.addEventListener("submit", async function(event) {
            event.preventDefault();
            if (!validateSizeSelection()) return;

            const formData = new FormData(this);
            const jsonData = Object.fromEntries(formData.entries());

            try {
                const response = await fetch("/user/add-to-cart", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(jsonData),
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Added to Cart!',
                        text: 'Product successfully added to your cart.',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        window.location.href = result.redirectUrl;
                    });
                } else {
                    showErrorAlert("Failed to Add", result.message || "Failed to add product to cart.");
                }
            } catch (error) {
                console.error("Error:", error);
                showErrorAlert("Error", "An unexpected error occurred. Please try again.");
            }
        });
    }

    function validateSizeSelection() {
        const size = document.querySelector('input[name="size"]:checked');
        if (!size) {
            showErrorAlert('Size Required', 'Please select a size before adding to cart.');
            return false;
        }
        return true;
    }

    function showErrorAlert(title, message) {
        return Swal.fire({
            icon: 'error',
            title: title,
            text: message,
            confirmButtonText: 'OK'
        });
    }

    function initializeBuyNow() {
        if (!buyNowForm) return;

        buyNowForm.addEventListener("submit", async function(event) {
            event.preventDefault();
            if (!validateSizeSelection()) return;

            const selectedSize = document.querySelector('input[name="size"]:checked');
            document.getElementById("hh").value = selectedSize.value;

            const formData = {
                productId: this.querySelector('input[name="productId"]').value,
                quantity: 1,
                size: selectedSize.value,
                price: this.querySelector('input[name="price"]').value
            };

            try {
                const response = await fetch("/user/checkout/buy-now", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    window.location.href = `/user/checkout/single?productId=${formData.productId}&quantity=${formData.quantity}&size=${formData.size}`;
                } else {
                    showErrorAlert('Checkout Failed', result.message || "Failed to proceed to checkout.");
                }
            } catch (error) {
                console.error("Error:", error);
                showErrorAlert('Error', 'An unexpected error occurred. Please try again.');
            }
        });
    }

    function initializeImageZoom() {
        zoomImages.forEach(image => {
            let isZoomed = false;
            let zoomLevel = 2;

            image.addEventListener("mousemove", function(e) {
                if (!isZoomed) return;
                const rect = this.getBoundingClientRect();
                const x = ((e.clientX - rect.left) / rect.width) * 100;
                const y = ((e.clientY - rect.top) / rect.height) * 100;
                this.style.transformOrigin = `${x}% ${y}%`;
                this.style.transform = `scale(${zoomLevel})`;
            });

            image.addEventListener("mouseenter", function() {
                isZoomed = true;
                this.style.transform = `scale(${zoomLevel})`;
            });

            image.addEventListener("mouseleave", function() {
                isZoomed = false;
                this.style.transform = "scale(1)";
            });

            image.addEventListener("wheel", function(e) {
                e.preventDefault();
                if (isZoomed) {
                    if (e.deltaY < 0 && zoomLevel < 4) zoomLevel += 0.5;
                    else if (e.deltaY > 0 && zoomLevel > 1.5) zoomLevel -= 0.5;
                    this.style.transform = `scale(${zoomLevel})`;
                }
            });
        });
    }
});
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>