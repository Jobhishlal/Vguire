<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container login-container" id="login">
        <div class="login-form-container">
            <div class="login-form">
                <!-- Title -->
                <h2 class="text-center">OTP Verification</h2>

                <!-- Error Message -->
                <% if (err) { %>
                    <p class="text-danger text-center"><%= err %></p> 
                <% } %>

                <!-- OTP Form -->
                <form action="/user/verify-otp" method="POST">
                    <div class="form-group">

                        <label for="otp">Enter the OTP:</label>
                        <input type="text" 
                               class="form-control" 
                               id="otp" 
                               name="otp" 
                               placeholder="Enter OTP" 
                               pattern="[0-9]{6}" 
                               title="Enter a valid 6-digit OTP" 
                               required 
                               autocomplete="one-time-code">
                    </div>

                    <!-- Hidden Email Field -->
                    <input type="hidden" name="email" value="<%= userEmail %>" />
                    
                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary btn-block">Verify OTP</button>
                </form>

                <!-- Resend OTP Section -->
                <div class="mt-3 text-center">
                    <button id="resendOtpBtn" class="btn btn-link text-secondary" disabled>Resend OTP</button>
                    <p id="timer" class="text-danger font-weight-bold" style="font-size: 14px;">
                        Resend OTP available in 60 seconds
                    </p>
                </div>
            </div>

            <!-- Logo Section -->
            <div class="logo text-center mt-4">
                <img src="/image/Screenshot%202025-01-02%20185508.png" alt="Logo" style="max-width: 120px;">
                <p class="mt-2 text-muted">Your trusted platform</p>
            </div>
        </div>
    </div>

    <script>
        let resendCooldown = <%= otpRemainingTime %>; // Get from backend dynamically
        const resendBtn = document.getElementById('resendOtpBtn');
        const timer = document.getElementById('timer');
    
        const startTimer = () => {
            console.log('Timer started from', resendCooldown, 'seconds');
    
            const interval = setInterval(() => {
                if (resendCooldown > 0) {
                    timer.textContent = `Resend OTP available in ${resendCooldown--} seconds`;
                } else {
                    clearInterval(interval);
                    timer.textContent = '';
                    resendBtn.disabled = false; // Enable button after cooldown
                }
            }, 1000);
        };
    
        document.addEventListener('DOMContentLoaded', startTimer); // Start on page load
    
        resendBtn.addEventListener('click', async () => {
            resendBtn.disabled = true;
            resendCooldown = 60; // Reset cooldown for next resend
            startTimer(); // Restart timer
    
            try {
                console.log('Resend OTP clicked');
    
                const response = await fetch('/user/resend-signup-otp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
    
                const data = await response.json();
                if (data.success) {
                    console.log('OTP resent successfully');
                } else {
                    console.log('Error:', data.msg);
                    alert(data.msg);
                }
            } catch (error) {
                console.error('Error in resending OTP:', error);
                alert('Server error. Please try again later.');
            }
        });
    </script>
    
    
    

    <!-- External Scripts -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
