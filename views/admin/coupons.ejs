<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        /* Assuming CSS variables are defined elsewhere, fallback values added */
        :root {
            --dark-bg: #1a1a1a;
            --text-color: #ffffff;
            --sidebar-width: 250px;
            --sidebar-collapsed-width: 80px;
            --header-height: 60px;
            --card-bg: #2c2c2c;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            margin: 0;
            padding: 0;
        }

        .content-wrapper {
            padding: 2rem;
            margin-top: var(--header-height);
            margin-left: var(--sidebar-width);
            transition: margin-left 0.3s ease;
            z-index: 2; /* Ensure main content is above the navbar */
            position: relative;
        }

        .sidebar.collapsed + .content-wrapper {
            margin-left: var(--sidebar-collapsed-width);
        }

        .page-header {
            background: linear-gradient(45deg, #1e3c72, #2a5298);
            padding: 2rem;
            border-radius: 1rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card {
            background-color: var(--card-bg);
            border: none;
            border-radius: 1rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .table {
            color: var(--text-color);
            width: 100%;
            min-width: 600px; /* Ensures table doesn't collapse too much */
        }

        .table-dark {
            background-color: var(--card-bg);
        }

        .badge {
            font-size: 0.85rem;
            padding: 0.5em 0.8em;
        }

        .btn-add-coupon {
            background: linear-gradient(45deg, #2ecc71, #27ae60);
            border: none;
            padding: 0.8rem 1.5rem;
            font-weight: 500;
            transition: transform 0.2s;
        }

        .btn-add-coupon:hover {
            transform: translateY(-2px);
        }

        .btn-edit {
            background: linear-gradient(45deg, #f1c40f, #f39c12);
            border: none;
        }

        .btn-remove {
            background: linear-gradient(45deg, #e74c3c, #c0392b);
            border: none;
        }

        .table-responsive {
            border-radius: 1rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch; /* Smooth scrolling on mobile */
        }

        .pagination {
            display: inline-block;
            margin-top: 20px;
            text-align: center;
            width: 100%;
        }

        .pagination a, .pagination span {
            color: #333;
            float: none;
            padding: 8px 16px;
            text-decoration: none;
            transition: background-color 0.3s;
            margin: 0 4px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .pagination a:hover {
            background-color: #f0f0f0;
        }

        .pagination a.active {
            background-color: #007bff;
            color: white;
            border: 1px solid #007bff;
        }

        .pagination span {
            padding: 8px 16px;
            color: grey;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin: 0 4px;
        }

        /* Media Queries for Responsiveness */
        @media (max-width: 992px) {
            .content-wrapper {
                margin-left: 0; /* Remove sidebar margin on smaller screens if sidebar collapses */
                padding: 1.5rem;
            }

            .page-header {
                padding: 1.5rem;
            }

            .btn-add-coupon {
                padding: 0.6rem 1.2rem;
                font-size: 0.9rem;
            }
        }

        @media (max-width: 768px) {
            .content-wrapper {
                padding: 1rem;
            }

            .page-header {
                padding: 1rem;
            }

            .table th, .table td {
                padding: 0.75rem; /* Reduce padding */
                font-size: 0.9rem; /* Adjust font size */
            }

            .btn-add-coupon {
                padding: 0.5rem 1rem;
                font-size: 0.85rem;
            }

            .btn-edit, .btn-remove {
                padding: 0.4rem 0.8rem;
                font-size: 0.8rem;
            }

            .badge {
                font-size: 0.75rem;
            }

            .pagination a, .pagination span {
                padding: 6px 12px;
                font-size: 0.9rem;
            }
        }

        @media (max-width: 576px) {
            .content-wrapper {
                padding: 0.75rem;
            }

            .page-header {
                padding: 0.75rem;
            }

            .page-header h1 {
                font-size: 1.5rem;
            }

            .page-header p {
                font-size: 0.9rem;
            }

            .table th, .table td {
                padding: 0.5rem;
                font-size: 0.8rem;
            }

            .btn-add-coupon {
                padding: 0.4rem 0.8rem;
                font-size: 0.75rem;
            }

            .btn-edit, .btn-remove {
                padding: 0.3rem 0.6rem;
                font-size: 0.7rem;
            }

            .badge {
                font-size: 0.65rem;
                padding: 0.4em 0.6em;
            }

            .pagination a, .pagination span {
                padding: 5px 10px;
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/admin/navbar.ejs') %>

    <div class="content-wrapper">
        <div class="page-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-0">Coupon Management</h1>
                    <p class="text-light mb-0">Manage your store's promotional offers</p>
                </div>
                <a href="/admin/coupons/add" class="btn btn-add-coupon">
                    <i class="fas fa-plus-circle me-2"></i>Add New Coupon
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Discount Type</th>
                                <th>Value</th>
                                <th>Start Date</th>
                                <th>Expiration</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% coupons.forEach(function(coupon) { %>
                            <tr>
                                <td>
                                    <span class="fw-bold"><%= coupon.code %></span>
                                </td>
                                <td>
                                    <span class="badge bg-info"><%= coupon.discountType %></span>
                                </td>
                                <td>
                                    <%= coupon.value %><%=coupon.discountType === 'percentage' ? '%' : '₹' %>
                                </td>
                                <td>
                                    <span class="<%= new Date(coupon.startDate) > new Date() ? 'text-danger' : 'text-success' %>">
                                        <%= new Date(coupon.startDate).toLocaleDateString() %>
                                    </span>
                                </td>
                                <td>
                                    <span class="<%= new Date(coupon.expirationDate) < new Date() ? 'text-danger' : 'text-success' %>">
                                        <%= new Date(coupon.expirationDate).toLocaleDateString() %>
                                    </span>
                                </td>
                                <td>
                                    <% 
                                        const currentDate = new Date();
                                        if (new Date(coupon.startDate) > currentDate) { 
                                    %>
                                        <span class="badge bg-secondary">Not Started</span>
                                    <% 
                                        } else if (new Date(coupon.expirationDate) < currentDate) { 
                                    %>
                                        <span class="badge bg-danger">Expired</span>
                                    <% 
                                        } else if (coupon.usedCount >= coupon.usageLimit) { 
                                    %>
                                        <span class="badge bg-warning">Limit Reached</span>
                                    <% 
                                        } else { 
                                    %>
                                        <span class="badge bg-success">Active</span>
                                    <% 
                                        } 
                                    %>
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="/admin/coupons/edit/<%= coupon._id %>" 
                                           class="btn btn-edit btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button class="btn btn-remove btn-sm remove-btn" 
                                                data-id="<%= coupon._id %>">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&limit=10">Previous</a>
        <% } %>
      
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="?page=<%= i %>&limit=10" class="<%= currentPage === i ? 'active' : '' %>"><%= i %></a>
        <% } %>
      
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&limit=10">Next</a>
        <% } %>
      </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.all.min.js"></script>
    <script>
        document.querySelectorAll('.remove-btn').forEach(button => {
            button.addEventListener('click', async function(event) {
                const couponId = event.target.closest('.remove-btn').getAttribute('data-id');

                const result = await Swal.fire({
                    title: 'Are you sure?',
                    text: "This coupon will be permanently deleted!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e74c3c',
                    cancelButtonColor: '#95a5a6',
                    confirmButtonText: 'Yes, delete it!'
                });

                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/admin/coupons/remove/${couponId}`, {
                            method: 'DELETE',
                        });

                        const data = await response.json();

                        if (response.ok) {
                            await Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: data.message,
                                showConfirmButton: false,
                                timer: 1500
                            });
                            event.target.closest('tr').remove();
                        } else {
                            throw new Error(data.message || 'Failed to delete coupon');
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: error.message,
                        });
                    }
                }
            });
        });
    </script>
</body>
</html>