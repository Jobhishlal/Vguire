<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <title>Document</title>
    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-collapsed-width: 70px;
            --header-height: 60px;
            --primary-color: #cbcfda;
            --secondary-color: #858796;
            --dark-bg: #1a1a1a;
            --card-bg: #242424;
            --text-color: #e4e4e4;
            --main-bg: #1f1f1f;
        }
       
        /* Main Content Styles */
        main {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            background-color: var(--main-bg);
            color: var(--text-color);
            transition: margin-left 0.3s ease;
        }
        .sidebar.collapsed + main {
            margin-left: var(--sidebar-collapsed-width);
        }
        .container {
            max-width: 600px;
            margin: auto;
            background-color: var(--card-bg);
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
        h2 {
            color: #3bf113;
            margin-bottom: 2rem;
        }
        .alert {
            margin-bottom: 1rem;
            padding: 1rem;
            border-radius: 8px;
        }
        .alert-success {
            background-color: #155724;
            border-color: #12461d;
            color: #d4edda;
        }
        .alert-danger {
            background-color: #721c24;
            border-color: #66151c;
            color: #f8d7da;
        }
        .form-label {
            color: var(--text-color);
        }
        .form-control {
            background-color: var(--dark-bg);
            border-color: var(--secondary-color);
            color: var(--text-color);
        }
        .btn-success {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: var(--dark-bg);
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            width: 100%;
        }
        .btn-success:hover {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
        }
        .btn-secondary {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
            color: var(--text-color);
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            width: 100%;
        }
        .btn-secondary:hover {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
    </style>
</head>
<body style="background-color: #1f1f1f;">
    <%- include('../partials/admin/navbar.ejs') %>

    <main>
        <div class="container mt-5">
            <h2 class="text-center mb-4">Apply Offer to <%= category.name %></h2>

            <!-- Success or Error Messages -->
            <% if (messages.success && messages.success.length > 0) { %>
                <div class="alert alert-success" role="alert">
                    <%= messages.success %>
                </div>
            <% } %>
            <% if (messages.error && messages.error.length > 0) { %>
                <div class="alert alert-danger" role="alert">
                    <%= messages.error %>
                </div>
            <% } %>

            <form action="/admin/category/<%= category._id %>/offer" method="POST">
                <div class="form-group mb-3">
                    <label for="offerPercentage">Offer Percentage (%)</label>
                    <input type="number" id="offerPercentage" name="offerPercentage" class="form-control" min="1" max="90" required>
                </div>

                <button type="submit" class="btn btn-success btn-lg w-100">Apply Offer</button>
            </form>

            <a href="/admin/categories" class="btn btn-secondary mt-3 w-100">Back to Categories</a>
        </div>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    </main>
</body>
</html>
