<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VGURIE Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-collapsed-width: 70px;
            --header-height: 60px;
            --primary-color: #cbcfda;
            --secondary-color: #858796;
            --dark-bg: #1a1a1a;
            --card-bg: #242424;
            --text-color: #e4e4e4;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #010612 0%, #224abe 100%);
            transition: width 0.3s ease, transform 0.3s ease;
            z-index: 1000;
            padding-top: var(--header-height);
        }

        .sidebar.collapsed {
            width: var(--sidebar-collapsed-width);
        }

        .sidebar-header {
            position: fixed;
            top: 0;
            width: var(--sidebar-width);
            height: var(--header-height);
            background: rgba(1, 6, 18, 0.9);
            display: flex;
            align-items: center;
            padding: 0 1rem;
            transition: width 0.3s ease;
        }

        .sidebar.collapsed .sidebar-header {
            width: var(--sidebar-collapsed-width);
        }

        .logo-full { display: flex; align-items: center; color: white; font-size: 1.5rem; font-weight: bold; text-decoration: none; }
        .logo-mini { display: none; color: white; font-size: 1.5rem; font-weight: bold; text-decoration: none; }
        .sidebar.collapsed .logo-full { display: none; }
        .sidebar.collapsed .logo-mini { display: block; }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

        .nav-link:hover {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }

        .nav-link i { width: 20px; text-align: center; margin-right: 1rem; }
        .sidebar.collapsed .nav-link span { display: none; }
        .sidebar.collapsed .nav-link i { margin-right: 0; }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: calc(var(--header-height) + 1rem) 1rem 1rem;
            transition: margin-left 0.3s ease;
        }

        .sidebar.collapsed + .main-content {
            margin-left: var(--sidebar-collapsed-width);
        }

        .content-header {
            position: fixed;
            top: 0;
            right: 0;
            left: var(--sidebar-width);
            height: var(--header-height);
            background: var(--card-bg);
            padding: 0 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 999;
            transition: left 0.3s ease;
        }

        .sidebar.collapsed ~ .main-content .content-header {
            left: var(--sidebar-collapsed-width);
        }

        .toggle-sidebar {
            background: none;
            border: none;
            color: var(--text-color);
            font-size: 1.25rem;
            cursor: pointer;
            padding: 0.5rem;
        }

        /* Page Header */
        .page-header {
            background: var(--card-bg);
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .btn-add-product {
            background: linear-gradient(45deg, var(--primary-color), #6610f2);
            border: none;
            transition: all 0.3s ease;
        }

        .btn-add-product:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(78, 115, 223, 0.3);
        }

        /* Filters Section */
        .filters-section {
            background: var(--card-bg);
            border-radius: 1rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

        /* Table Styles */
        .product-table {
            background: var(--card-bg);
            border-radius: 1rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .table {
            color: var(--text-color);
            margin-bottom: 0;
        }

        .table thead th {
            background: rgba(211, 213, 216, 0.1);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            padding: 1rem;
            border-bottom: none;
        }

        .table tbody tr td {
            padding: 1rem;
            vertical-align: middle;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .product-image {
            width: 50px;
            height: 50px;
            border-radius: 8px;
            object-fit: cover;
            transition: transform 0.2s;
        }

        .product-image:hover { transform: scale(1.1); }

        .product-info { max-width: 300px; }
        .product-name { font-weight: 600; margin-bottom: 0.25rem; }
        .product-description {
            font-size: 0.875rem;
            color: var(--secondary-color);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .stock-warning { color: #f1c40f; }
        .stock-danger { color: #e74c3c; }

        .size-indicator {
            width: 35px;
            height: 35px;
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
        }

        /* Pagination */
        .pagination .page-item .page-link {
            background: var(--card-bg);
            color: var(--text-color);
            border: none;
            padding: 0.75rem 1.25rem;
            transition: background 0.3s ease;
        }

        .pagination .page-item.active .page-link {
            background: var(--primary-color);
            color: var(--dark-bg);
        }

        .pagination .page-item .page-link:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .sidebar {
                width: var(--sidebar-width);
                transform: translateX(-100%);
            }

            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .content-header { left: 0; }
            .table-responsive { overflow-x: auto; }
            .table thead th, .table tbody tr td { padding: 0.75rem; }
            .product-image { width: 40px; height: 40px; }
            .size-indicator { width: 30px; height: 30px; font-size: 0.75rem; }
        }

        @media (max-width: 768px) {
            .table thead th { font-size: 0.75rem; }
            .table tbody tr td { padding: 0.5rem; }
            .product-info { max-width: 150px; }
            .pagination .page-link { padding: 0.5rem 1rem; }
        }

        @media (max-width: 576px) {
            .table thead { display: none; }
            .table tbody tr { display: block; margin-bottom: 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
            .table tbody tr td {
                display: block;
                padding: 0.5rem;
                text-align: left;
            }
            .table tbody tr td::before {
                content: attr(data-label);
                font-weight: bold;
                display: block;
                margin-bottom: 0.25rem;
            }
            .product-image { width: 35px; height: 35px; }
            .size-indicator { width: 25px; height: 25px; font-size: 0.7rem; }
            .btn-add-product { width: 100%; justify-content: center; }
        }

        /* Backdrop for Mobile Sidebar */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }

        @media (max-width: 992px) {
            .sidebar.show ~ .sidebar-backdrop { display: block; }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-header">
            <a href="#" class="logo-full"><i class="fas fa-shopping-bag me-2"></i>VGURIE</a>
            <a href="#" class="logo-mini"><i class="fas fa-shopping-bag"></i></a>
        </div>
        <div class="nav flex-column">
            <div class="nav-item"><a href="/admin/dashboard" class="nav-link"><i class="fas fa-th-large"></i><span>Dashboard</span></a></div>
            <div class="nav-item"><a href="/admin/product" class="nav-link"><i class="fas fa-box"></i><span>Products</span></a></div>
            <div class="nav-item"><a href="/admin/ordermanagement" class="nav-link"><i class="fas fa-shopping-cart"></i><span>Orders</span></a></div>
            <div class="nav-item"><a href="/admin/usersmanagement" class="nav-link"><i class="fas fa-users"></i><span>Users</span></a></div>
            <div class="nav-item"><a href="/admin/categories" class="nav-link"><i class="fas fa-tags"></i><span>Categories</span></a></div>
            <div class="nav-item"><a href="/admin/returnRequests" class="nav-link"><i class="fas fa-undo-alt"></i><span>Returns & Refunds</span></a></div>
            <div class="nav-item"><a href="#" class="nav-link"><i class="fas fa-ticket-alt"></i><span>Coupons</span></a></div>
            <div class="nav-item"><a href="#" class="nav-link"><i class="fas fa-image"></i><span>Banners</span></a></div>
            <div class="nav-item"><a href="#" class="nav-link"><i class="fas fa-cog"></i><span>Settings</span></a></div>
            <div class="nav-item mt-auto"><a href="#" class="nav-link text-danger"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></div>
        </div>
    </nav>
    <div class="sidebar-backdrop"></div>

    <!-- Main Content -->
    <main class="main-content">
        <header class="content-header">
            <button class="toggle-sidebar" aria-label="Toggle sidebar"><i class="fas fa-bars"></i></button>
            <div class="user-menu">
                <div class="dropdown">
                    <button class="btn btn-link text-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle me-1"></i>Admin
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="container-fluid">
            <!-- Page Header -->
            <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                <h1 class="page-title"><i class="fas fa-box"></i> Product Management</h1>
                <a href="/admin/add-product"><button class="btn btn-add-product btn-lg text-white"><i class="fas fa-plus"></i> Add New Product</button></a>
            </div>

            <!-- Filters -->
            <div class="filters-section">
                <select class="form-select bg-transparent text-light border-0">
                    <option value="">Stock Status</option>
                    <option value="in-stock">In Stock</option>
                    <option value="low-stock">Low Stock</option>
                    <option value="out-of-stock">Out of Stock</option>
                </select>
            </div>

            <!-- Product Table -->
            <div class="card product-table">
                <div class="table-responsive">
                    <table class="table table-dark table-hover">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Sizes [S,M,L,XL,XXL]</th>
                                <th>Status</th>
                                <th>Actions</th>
                                <th>Offer Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach(product => { %>
                            <tr>
                                <td data-label="Image">
                                    <div class="product-image-container d-flex gap-2 flex-wrap">
                                        <% if (product.images && product.images.length > 0) { %>
                                            <% product.images.slice(0, 5).forEach(image => { %>
                                                <img src="/uploads/products/<%= image.split('/').pop() %>" 
                                                     class="product-image" 
                                                     alt="<%= product.name %>">
                                            <% }); %>
                                        <% } else { %>
                                            <div class="product-image bg-secondary d-flex align-items-center justify-content-center">
                                                <i class="fas fa-image"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                </td>
                                <td data-label="Product">
                                    <div class="product-info">
                                        <div class="product-name"><%= product.name %></div>
                                        <div class="product-description"><%= product.description.substring(0, 100) %>...</div>
                                    </div>
                                </td>
                                <td data-label="Category"><%= product.category ? product.category.name : 'N/A' %></td>
                                <td data-label="Price"><div class="fw-bold">₹<%= product.price %></div></td>
                                <td data-label="Stock">
                                    <div class="<%= product.totalStock < 5 ? 'stock-danger' : (product.totalStock < 10 ? 'stock-warning' : '') %>">
                                        <%= product.totalStock %>
                                    </div>
                                </td>
                                <td data-label="Sizes [S,M,L,XL,XXL]">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <div class="size-indicator"><%= product.sizeS %></div>
                                        <div class="size-indicator"><%= product.sizeM %></div>
                                        <div class="size-indicator"><%= product.sizeL %></div>
                                        <div class="size-indicator"><%= product.sizeXL %></div>
                                        <div class="size-indicator"><%= product.sizeXXL %></div>
                                    </div>
                                </td>
                                <td data-label="Status">
                                    <% if (product.totalStock > 10) { %>
                                        <span class="badge bg-success-subtle text-success">In</span>
                                    <% } else if (product.totalStock > 0) { %>
                                        <span class="badge bg-warning-subtle text-warning">Low</span>
                                    <% } else { %>
                                        <span class="badge bg-danger-subtle text-danger">Out</span>
                                    <% } %>
                                </td>
                                <td data-label="Actions">
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a href="/admin/edit-product/<%= product._id %>" class="btn btn-success btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/admin/product/<%= product._id %>/offer" class="btn btn-warning btn-sm">
                                            <i class="fas fa-tag"></i>
                                        </a>
                                        <% if (product.isOfferActive) { %>
                                            <a href="/admin/product/<%= product._id %>/remove-offer" class="btn btn-danger btn-sm">
                                                <i class="fas fa-times-circle"></i>
                                            </a>
                                        <% } %>
                                    </div>
                                </td>
                                <td data-label="Offer Status">
                                    <% if (product.isOfferActive) { %>
                                        <% if (product.offerType === "product") { %>
                                            <span class="badge bg-success">Product Offer Active</span>
                                            <div>₹<%= product.Offerprice %></div>
                                        <% } else if (product.offerType === "category") { %>
                                            <span class="badge bg-info">Category Offer Active</span>
                                            <div>₹<%= Math.floor(product.price - (product.price * product.discountPercentage / 100)) %></div>
                                        <% } %>
                                    <% } else { %>
                                        <span class="badge bg-secondary">No Offer</span>
                                        <div>₹<%= product.price %></div>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <nav aria-label="Page navigation" class="d-flex justify-content-center mt-4">
                <ul class="pagination">
                    <% if (currentPage > 1) { %>
                        <li class="page-item"><a class="page-link" href="?page=<%= currentPage - 1 %>&limit=10">« Previous</a></li>
                    <% } else { %>
                        <li class="page-item disabled"><span class="page-link">« Previous</span></li>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <li class="page-item active"><span class="page-link"><%= i %></span></li>
                        <% } else { %>
                            <li class="page-item"><a class="page-link" href="?page=<%= i %>&limit=10"><%= i %></a></li>
                        <% } %>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <li class="page-item"><a class="page-link" href="?page=<%= currentPage + 1 %>&limit=10">Next »</a></li>
                    <% } else { %>
                        <li class="page-item disabled"><span class="page-link">Next »</span></li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // SweetAlert for Success/Error Messages
        <% if (messages.success.length > 0) { %>
            Swal.fire({
                icon: "success",
                title: "Success",
                text: "<%= messages.success[0] %>",
                confirmButtonColor: "#28a745"
            });
        <% } %>
        <% if (messages.error.length > 0) { %>
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "<%= messages.error[0] %>",
                confirmButtonColor: "#d33"
            });
        <% } %>

        // Sidebar Toggle
        const toggleSidebar = document.querySelector('.toggle-sidebar');
        const sidebar = document.querySelector('.sidebar');
        const backdrop = document.querySelector('.sidebar-backdrop');

        toggleSidebar.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
            if (window.innerWidth <= 992) {
                sidebar.classList.toggle('show');
            }
        });

        backdrop.addEventListener('click', () => {
            sidebar.classList.remove('show');
        });

        window.addEventListener('resize', () => {
            if (window.innerWidth > 992) {
                sidebar.classList.remove('show');
            }
        });

        // Close sidebar on outside click (mobile)
        document.addEventListener('click', (e) => {
            if (window.innerWidth <= 992) {
                if (!sidebar.contains(e.target) && !toggleSidebar.contains(e.target)) {
                    sidebar.classList.remove('show');
                }
            }
        });
    </script>
</body>
</html>