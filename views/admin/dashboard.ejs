<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VGURIE Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-collapsed-width: 70px;
            --header-height: 60px;
            --fluorescent-green: #08ee22;
            --gradient-green: linear-gradient(135deg, #28a745, #08ee22);
            --card-bg: #242424;
            --text-color: #e4e4e4;
            --dark-bg: #1a1a1a;
        }

        body {
            background: var(--dark-bg);
            color: var(--text-color);
            min-height: 100vh;
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            margin-left: var(--sidebar-width);
            transition: margin-left 0.3s ease;
        }

        .sidebar.collapsed + body {
            margin-left: var(--sidebar-collapsed-width);
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            padding: 1rem; /* Reduced padding to minimize space */
            margin-top: var(--header-height);
        }

        .filter-section {
            background: var(--card-bg);
            padding: 1rem;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .filter-section select, .filter-section input {
            background: #333;
            border: 1px solid var(--fluorescent-green);
            color: var(--text-color);
            border-radius: 8px;
            padding: 0.5rem;
            transition: all 0.3s ease;
        }

        .filter-section select:focus, .filter-section input:focus {
            box-shadow: 0 0 5px var(--fluorescent-green);
            outline: none;
        }

        .filter-section button {
            background: var(--gradient-green);
            color: #121212;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            border: none;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .filter-section button:hover {
            background: linear-gradient(135deg, #2ecc71, #08ee22);
            box-shadow: 0 0 10px var(--fluorescent-green);
        }

        .summary-box {
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
            text-align: center;
            border: 1px solid var(--fluorescent-green);
            transition: transform 0.3s ease;
            flex: 1;
            min-width: 200px;
        }

        .summary-box:hover {
            transform: translateY(-5px);
        }

        .summary-box h4 {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--text-color);
        }

        .summary-box p {
            font-size: 1.5rem;
            color: var(--fluorescent-green);
            font-weight: bold;
        }

        .report-container {
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
            margin-top: 1.5rem;
        }

        .report-container h3 {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--fluorescent-green);
        }

        .chart-container {
            width: 100%;
            max-width: 500px;
            margin: 20px auto;
            background: linear-gradient(135deg, #333, #242424);
            padding: 1.5rem;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.7), inset 0 0 10px rgba(8, 238, 34, 0.2);
            border: 1px solid var(--fluorescent-green);
            min-height: 400px;
            position: relative;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table {
            width: 100%;
            min-width: 800px; /* Ensures table doesn't collapse too much */
            border-collapse: collapse;
        }

        .table th {
            background: #222;
            color: white;
            border-color: #444;
            font-weight: bold;
            padding: 12px 15px;
        }

        .table td {
            background: var(--card-bg);
            color: var(--text-color);
            border-color: #444;
            padding: 12px 15px;
        }

        .download-buttons button {
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            border-radius: 8px;
            border: none;
            transition: all 0.3s ease;
            font-weight: bold;
        }

        .download-buttons .btn-success {
            background: linear-gradient(135deg, #28a745, #34c759);
            color: white;
        }

        .download-buttons .btn-success:hover {
            background: linear-gradient(135deg, #218838, #2ecc71);
            box-shadow: 0 0 10px #28a745;
        }

        .download-buttons .btn-danger {
            background: linear-gradient(135deg, #dc3545, #ff5767);
            color: white;
        }

        .download-buttons .btn-danger:hover {
            background: linear-gradient(135deg, #c82333, #e84351);
            box-shadow: 0 0 10px #dc3545;
        }

        .download-buttons .btn-info {
            background: var(--gradient-green);
            color: #121212;
        }

        .download-buttons .btn-info:hover {
            background: linear-gradient(135deg, #2ecc71, #08ee22);
            box-shadow: 0 0 10px var(--fluorescent-green);
        }

        .dashboard-section {
            flex: 1;
            background: #1e1e1e;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            color: #fff;
            min-width: 300px;
        }

        .table-container {
            width: 100%;
            overflow-x: auto;
            padding: 10px;
        }

        .styled-table {
            width: 100%;
            min-width: 600px;
            border-collapse: collapse;
            font-family: Arial, sans-serif;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background-color: #2c2c2c;
        }

        .styled-table th, 
        .styled-table td {
            padding: 12px 15px;
            text-align: center;
            border-bottom: 1px solid #444;
            color: #fff;
        }

        .styled-table thead {
            background-color: #34495e;
            color: #ffffff;
            font-weight: bold;
        }

        .styled-table tbody tr:nth-child(even) {
            background-color: #1a1a1a;
        }

        .styled-table tbody tr:hover {
            background-color: #333;
        }

        .product-image, .category-image {
            width: 50px;
            height: 50px;
            border-radius: 5px;
            object-fit: cover;
            border: 1px solid #ddd;
        }

        .placeholder-image {
            width: 50px;
            height: 50px;
            background: #555;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
        }

        .category-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Media Queries */
        @media (max-width: 1200px) {
            .main-content {
                padding: 1rem;
            }

            .chart-container {
                max-width: 100%;
            }

            .summary-box {
                min-width: 180px;
            }
        }

        @media (max-width: 992px) {
            body {
                margin-left: 0;
            }

            .main-content {
                padding: 0.75rem;
            }

            .filter-section {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-section select, .filter-section input, .filter-section button {
                width: 100%;
            }

            .summary-boxes {
                flex-direction: column;
            }

            .dashboard-container {
                flex-direction: column;
            }

            .report-container {
                padding: 1rem;
            }

            .chart-container {
                min-height: 300px;
            }
        }

        @media (max-width: 768px) {
            body {
                margin-left: var(--sidebar-collapsed-width);
            }

            .report-container h3 {
                font-size: 1.5rem;
            }

            .summary-box h4 {
                font-size: 1rem;
            }

            .summary-box p {
                font-size: 1.2rem;
            }

            .download-buttons {
                flex-direction: column;
                gap: 1rem;
            }

            .download-buttons button {
                width: 100%;
            }

            .table th, .table td {
                padding: 8px;
                font-size: 14px;
            }

            .styled-table th, .styled-table td {
                padding: 8px;
                font-size: 14px;
            }

            .product-image, .category-image {
                width: 40px;
                height: 40px;
            }
        }

        @media (max-width: 576px) {
            body {
                margin-left: var(--sidebar-collapsed-width);
            }

            .main-content {
                padding: 0.5rem;
            }

            .report-container {
                padding: 0.75rem;
            }

            .chart-container {
                padding: 1rem;
                min-height: 250px;
            }

            .table th, .table td {
                padding: 6px;
                font-size: 12px;
            }

            .styled-table th, .styled-table td {
                padding: 6px;
                font-size: 12px;
            }

            .product-image, .category-image {
                width: 30px;
                height: 30px;
            }
        }
        /* Filter section responsive design for screen below 720px */
@media (max-width: 720px) {
  .filter-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }

  .filter-section label {
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
  }

  .filter-section select,
  .filter-section input,
  .filter-section button {
    width: 100% !important;
  }

  #monthYearSelection,
  #customDateRange,
  #lineFilterSection {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  #monthYearSelection label,
  #customDateRange label,
  #lineFilterSection label {
    width: 100%;
  }

  .filter-section button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--gradient-green);
    color: white;
  }
}

    </style>
</head>
<body>
    <div class="dashboard-container">
        <%- include('../partials/admin/navbar.ejs') %>

        <main class="main-content">
            <div class="filter-section">
                <label for="filter" class="fw-bold">Report Type:</label>
                <select id="filter" class="form-select w-auto">
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                    <option value="monthly" selected>Monthly</option>
                    <option value="yearly">Yearly</option>
                    <option value="custom">Custom Date</option>
                </select>

                <div id="monthYearSelection" class="d-flex align-items-center gap-2">
                    <label for="month">Month:</label>
                    <select id="month" class="form-select w-auto">
                        <option value="1" <%= (new Date().getMonth() + 1) === 1 ? 'selected' : '' %>>January</option>
                        <option value="2" <%= (new Date().getMonth() + 1) === 2 ? 'selected' : '' %>>February</option>
                        <option value="3" <%= (new Date().getMonth() + 1) === 3 ? 'selected' : '' %>>March</option>
                        <option value="4" <%= (new Date().getMonth() + 1) === 4 ? 'selected' : '' %>>April</option>
                        <option value="5" <%= (new Date().getMonth() + 1) === 5 ? 'selected' : '' %>>May</option>
                        <option value="6" <%= (new Date().getMonth() + 1) === 6 ? 'selected' : '' %>>June</option>
                        <option value="7" <%= (new Date().getMonth() + 1) === 7 ? 'selected' : '' %>>July</option>
                        <option value="8" <%= (new Date().getMonth() + 1) === 8 ? 'selected' : '' %>>August</option>
                        <option value="9" <%= (new Date().getMonth() + 1) === 9 ? 'selected' : '' %>>September</option>
                        <option value="10" <%= (new Date().getMonth() + 1) === 10 ? 'selected' : '' %>>October</option>
                        <option value="11" <%= (new Date().getMonth() + 1) === 11 ? 'selected' : '' %>>November</option>
                        <option value="12" <%= (new Date().getMonth() + 1) === 12 ? 'selected' : '' %>>December</option>
                    </select>
                    <label for="year">Year:</label>
                    <select id="year" class="form-select w-auto">
                        <% for(let y = new Date().getFullYear(); y >= new Date().getFullYear() - 10; y--) { %>
                            <option value="<%= y %>" <%= y === new Date().getFullYear() ? 'selected' : '' %>><%= y %></option>
                        <% } %>
                    </select>
                    <div id="customDateRange" class="d-flex align-items-center gap-2" style="display: none;">
                        <label for="startDate">Start:</label>
                        <input type="date" id="startDate" class="form-control w-auto">
                        <label for="endDate">End:</label>
                        <input type="date" id="endDate" class="form-control w-auto">
                    </div>
                </div>

                <div id="lineFilterSection" class="d-flex align-items-center gap-2" style="display: none;">
                    <label for="lineFilter" class="fw-bold">Line Chart View:</label>
                    <select id="lineFilter" class="form-select w-auto">
                        <option value="week">Week</option>
                        <option value="day">Day</option>
                    </select>
                </div>

                <button class="btn" onclick="fetchSalesReport()">
                    <i class="fas fa-chart-line me-2"></i>Get Report
                </button>
            </div>

            <div class="summary-boxes mt-4 d-flex flex-wrap gap-3">
                <div class="summary-box">
                    <h4>Users</h4>
                    <p><%= totalUsersCount || 0 %></p>
                </div>
                <div class="summary-box">
                    <h4>Total Sales</h4>
                    <p id="totalSalesSummary">₹<%= totalSales || 0 %></p>
                </div>
                <div class="summary-box">
                    <h4>Pending Orders</h4>
                    <p><%= pendingOrdersCount || 0 %></p>
                </div>
                <div class="summary-box">
                    <h4>Total Coupon Discount</h4>
                    <p id="totalCouponDiscountSummary">₹<%= totalCouponDiscount || 0 %></p>
                </div>
            </div>

            <div class="report-container">
                <h3 class="text-center mb-4">Sales Analytics</h3>
                <div class="d-flex flex-wrap justify-content-center gap-4">
                    <div class="chart-container">
                        <canvas id="barChart" width="400" height="400"></canvas>
                    </div>
                    <div class="chart-container">
                        <canvas id="pieChart" width="400" height="400"></canvas>
                    </div>
                    <div class="chart-container">
                        <canvas id="lineChart" width="400" height="400"></canvas>
                    </div>
                </div>
            </div>

            <div class="report-container text-center">
                <div class="report-summary">
                    <h3>Total Sales: ₹<span id="totalSales"><%= totalSales || 0 %></span></h3>
                    <h3>Total Orders: <span id="totalOrders"><%= totalOrders || 0 %></span></h3>
                    <h3>Total Products Sold: <span id="totalProductsSold"><%= totalProductsSold || 0 %></span></h3>
                    <h3>Total Coupon Discount: ₹<span id="totalCouponDiscount"><%= totalCouponDiscount || 0 %></span></h3>
                </div>
                <div class="mt-4">
                    <h4 class="fw-bold">Order Details</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Total Items</th>
                                    <th>Total Amount</th>
                                    <th>Offer Discount</th>
                                    <th>Coupon Discount</th>
                                    <th>Final Amount</th>
                                    <th>Payment Method</th>
                                    <th>Order Status</th>
                                </tr>
                            </thead>
                            <tbody id="ordersTableBody">
                                <% if (orders && orders.length > 0) { %>
                                    <% orders.forEach(order => { %>
                                        <tr>
                                            <td><%= order["Order ID"] %></td>
                                            <td><%= order["Total Items"] %></td>
                                            <td><%= order["Total Amount"] %></td>
                                            <td><%= order["Discount Applied"] %></td>
                                            <td><%= order["Coupon Discount"] %></td>
                                            <td><%= order["Final Amount"] %></td>
                                            <td><%= order["Payment Method"] %></td>
                                            <td><%= order["Order Status"] %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="download-buttons mt-4 d-flex justify-content-center gap-3">
                <button class="btn btn-success" onclick="fetchSalesReport('excel')">
                    <i class="fas fa-file-excel me-2"></i>Excel
                </button>
                <button class="btn btn-danger" onclick="fetchSalesReport('pdf')">
                    <i class="fas fa-file-pdf me-2"></i>PDF
                </button>
                <button class="btn btn-info" onclick="fetchSalesReport('json')">
                    <i class="fas fa-eye me-2"></i>View Report
                </button>
            </div>

            <div class="dashboard-container">
                <div class="dashboard-section">
                    <h3>Top 10 Ordered Products</h3>
                    <div class="table-container">
                        <table class="styled-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Image</th>
                                    <th>Product Name</th>
                                    <th>Total Orders</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topProducts.forEach((product, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td class="product-images">
                                            <% if (product.productDetails.images && product.productDetails.images.length > 0) { %>
                                                <img src="/uploads/products/<%= product.productDetails.images[0].split('/').pop() %>" 
                                                     class="product-image" 
                                                     alt="<%= product.productDetails.name %>">
                                            <% } else { %>
                                                <span class="placeholder-image">No Image</span>
                                            <% } %>
                                        </td>
                                        <td><%= product.productDetails.name %></td>
                                        <td><%= product.totalOrders %></td>
                                        <td><%= product.productDetails.price.toFixed(2) %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="dashboard-section">
                    <h3 class="dashboard-title">Top 10 Best-Selling Categories</h3>
                    <div class="table-container">
                        <table class="styled-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Category</th>
                                    <th>Total Orders</th>
                                    <th>Total Sales (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topCategories.forEach((category, index) => { %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td class="category-cell">
                                            <div class="category-info">
                                                <% if (category.image) { %>
                                                    <img src="/uploads/categories/<%= category.image %>" 
                                                         class="category-image" 
                                                         alt="<%= category.name %>">
                                                <% } else { %>
                                                    <div class="placeholder-image">No Image</div>
                                                <% } %>
                                                <span class="category-name"><%= category.name %></span>
                                            </div>
                                        </td>
                                        <td><%= category.totalOrders %></td>
                                        <td><%= category.totalAmount ? category.totalAmount.toFixed(2) : "0.00" %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let barChartInstance = null;
        let pieChartInstance = null;
        let lineChartInstance = null;

        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        function validateFilterInputs(filter) {
            if (filter === "monthly") {
                const month = document.getElementById("month").value;
                const year = document.getElementById("year").value;
                if (!month || !year) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Missing Selection',
                        text: 'Please select both month and year!',
                        confirmButtonColor: '#3085d6',
                    });
                    return false;
                }
            } else if (filter === "custom") {
                const startDate = document.getElementById("startDate").value;
                const endDate = document.getElementById("endDate").value;
                if (!startDate || !endDate) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Date Range Required',
                        text: 'Please select both start and end dates!',
                        confirmButtonColor: '#3085d6',
                    });
                    return false;
                }
            }
            return true;
        }

        async function fetchSalesReport(format = "json") {
            const filter = document.getElementById("filter").value;
            if (!validateFilterInputs(filter)) return;
            let url = `/admin/sales-report?filter=${filter}&format=${format}&t=${Date.now()}`;

            if (filter === "monthly") {
                const month = document.getElementById("month").value;
                const year = document.getElementById("year").value;
                url += `&month=${month}&year=${year}`;
            } else if (filter === "custom") {
                const startDate = document.getElementById("startDate").value;
                const endDate = document.getElementById("endDate").value;
                url += `&startDate=${startDate}&endDate=${endDate}`;
            }

            try {
                const response = await fetch(url);
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || "Failed to fetch sales report");
                }

                if (format === "json") {
                    const data = await response.json();
                    console.log("Sales Report Data:", data);
                    if (!data.orders || data.orders.length === 0) {
                        Swal.fire({
                            icon: 'info',
                            title: 'No Data',
                            text: 'No data found for the selected date range.',
                            confirmButtonColor: '#3085d6',
                        });
                    }
                    renderSalesReport(data);
                    await fetchChartData();
                } else {
                    const blob = await response.blob();
                    const fileURL = window.URL.createObjectURL(blob);
                    const a = document.createElement("a");
                    const fileName = format === "pdf" ? "Sales_Report.pdf" : "Sales_Report.xlsx";
                    a.href = fileURL;
                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }
            } catch (error) {
                console.error("Fetch Sales Report Error:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: `Failed to fetch sales report: ${error.message}.`,
                    confirmButtonColor: '#d33',
                });
            }
        }

        function renderSalesReport(data) {
            const ordersTableBody = document.getElementById("ordersTableBody");

            document.getElementById("totalSales").textContent = data.totalSales || 0;
            document.getElementById("totalOrders").textContent = data.totalOrders || 0;
            document.getElementById("totalProductsSold").textContent = data.totalProductsSold || 0;
            const totalCouponDiscount = Math.floor(data.totalCouponDiscount || 0);
            document.getElementById("totalCouponDiscount").textContent = totalCouponDiscount;

            document.getElementById("totalSalesSummary").textContent = `₹${data.totalSales || 0}`;
            document.getElementById("totalCouponDiscountSummary").textContent = `₹${totalCouponDiscount}`;

            ordersTableBody.innerHTML = (data.orders || []).map(order => `
                <tr>
                    <td>${order["Order ID"] || "N/A"}</td>
                    <td>${order["Total Items"] || 0}</td>
                    <td>${order["Total Amount"] || 0}</td>
                    <td>${order["Discount Applied"] || 0}</td>
                    <td>${order["Coupon Discount"] || 0}</td>
                    <td>${order["Final Amount"] || 0}</td>
                    <td>${order["Payment Method"] || "N/A"}</td>
                    <td>${order["Order Status"] || "N/A"}</td>
                </tr>
            `).join("");
        }

        async function fetchChartData() {
            const filter = document.getElementById("filter").value;
            if (!validateFilterInputs(filter)) return;
            let url = `/admin/chart-data?filter=${filter}`;

            let lineFilterValue = "week";
            if (filter === "monthly") {
                const month = document.getElementById("month").value;
                const year = document.getElementById("year").value;
                const lineFilter = document.getElementById("lineFilter").value;
                url += `&month=${month}&year=${year}&lineFilter=${lineFilter}`;
                lineFilterValue = lineFilter;
            } else if (filter === "custom") {
                const startDate = document.getElementById("startDate").value;
                const endDate = document.getElementById("endDate").value;
                url += `&startDate=${startDate}&endDate=${endDate}`;
            }

            try {
                const response = await fetch(url);
                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || `Failed to fetch chart data: ${response.statusText}`);
                }
                const data = await response.json();
                console.log("Chart Data Received:", data);
                renderCharts(data, filter, lineFilterValue);
            } catch (error) {
                console.error("Fetch Chart Data Error:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Chart Error',
                    text: error.message,
                    confirmButtonColor: '#d33',
                });
            }
        }

        function renderCharts(data, filter = "monthly", lineFilter = "week") {
            // Destroy existing instances if they exist
            if (barChartInstance) {
                barChartInstance.destroy();
                barChartInstance = null;
            }
            if (pieChartInstance) {
                pieChartInstance.destroy();
                pieChartInstance = null;
            }
            if (lineChartInstance) {
                lineChartInstance.destroy();
                lineChartInstance = null;
            }

            const barLabels = data.barChart?.labels || [];
            const barSales = data.barChart?.sales || [];
            const pieLabels = data.pieChart?.labels || [];
            const pieSales = data.pieChart?.sales || [];
            const lineLabels = data.lineChart?.labels || [];
            const lineSales = data.lineChart?.sales || [];
            const currentWeekSales = data.lineChart?.currentWeekSales || [];
            const previousWeekSales = data.lineChart?.previousWeekSales || [];

            console.log("Bar Chart Data:", { labels: barLabels, sales: barSales });
            console.log("Pie Chart Data:", { labels: pieLabels, sales: pieSales });
            console.log("Line Chart Data:", { labels: lineLabels, sales: lineSales, currentWeekSales, previousWeekSales });

            // Check if canvases exist
            const barCanvas = document.getElementById("barChart");
            const pieCanvas = document.getElementById("pieChart");
            const lineCanvas = document.getElementById("lineChart");

            if (!barCanvas || !pieCanvas || !lineCanvas) {
                console.error("One or more chart canvases not found in the DOM!");
                Swal.fire({
                    icon: 'error',
                    title: 'Chart Error',
                    text: 'Chart canvases not found in the DOM.',
                    confirmButtonColor: '#d33',
                });
                return;
            }

            // Render Bar Chart
            const barCtx = barCanvas.getContext("2d");
            if (barCtx && barLabels.length > 0 && barSales.length > 0) {
                const barGradient = barCtx.createLinearGradient(0, 0, 0, 400);
                barGradient.addColorStop(0, "rgba(8, 238, 34, 0.8)");
                barGradient.addColorStop(1, "rgba(46, 204, 113, 0.6)");
                barChartInstance = new Chart(barCtx, {
                    type: "bar",
                    data: {
                        labels: barLabels,
                        datasets: [{
                            label: "Total Sales",
                            data: barSales,
                            backgroundColor: barGradient,
                            borderColor: "#224abe",
                            borderWidth: 2,
                            borderRadius: 5,
                            barThickness: 30,
                        }],
                    },
                    options: {
                        animation: { duration: 1500, easing: "easeInOutQuart" },
                        maintainAspectRatio: false,
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                suggestedMax: Math.max(...barSales, 1000) * 1.2,
                                title: { display: true, text: "Sales (₹)", color: "#e4e4e4", font: { size: 14 } },
                                ticks: { color: "#e4e4e4", font: { size: 12 } },
                                grid: { color: "rgba(255, 255, 255, 0.1)" },
                            },
                            x: {
                                title: { 
                                    display: true, 
                                    text: filter === "weekly" ? "Day of Week" : filter === "yearly" ? "Month" : "Period", 
                                    color: "#e4e4e4", 
                                    font: { size: 14 } 
                                },
                                ticks: { color: "#e4e4e4", font: { size: 12 } },
                                grid: { display: false },
                            },
                        },
                        plugins: {
                            title: { 
                                display: true, 
                                text: filter === "weekly" ? "Weekly Sales Trend" : filter === "yearly" ? "Yearly Sales by Month" : "Sales Trend", 
                                color: "#224abe", 
                                font: { size: 16, weight: "bold" } 
                            },
                            legend: { labels: { color: "#e4e4e4", font: { size: 12 } } },
                            tooltip: { backgroundColor: "#333", titleColor: "#e4e4e4", bodyColor: "#e4e4e4" },
                        },
                    },
                });
                console.log("Bar Chart Rendered");
            } else {
                console.warn("Bar Chart: No data or context available");
            }

            // Render Pie Chart
            const pieCtx = pieCanvas.getContext("2d");
            if (pieCtx && pieLabels.length > 0 && pieSales.length > 0) {
                pieChartInstance = new Chart(pieCtx, {
                    type: "pie",
                    data: {
                        labels: pieLabels,
                        datasets: [{
                            label: "Sales by Payment Method",
                            data: pieSales,
                            backgroundColor: [
                                "rgba(255, 99, 132, 0.8)",
                                "rgba(54, 162, 235, 0.8)",
                                "rgba(255, 206, 86, 0.8)",
                                "rgba(75, 192, 192, 0.8)",
                                "rgba(153, 102, 255, 0.8)",
                            ],
                            borderColor: "#224abe",
                            borderWidth: 2,
                        }],
                    },
                    options: {
                        animation: { duration: 1500, easing: "easeInOutQuart" },
                        maintainAspectRatio: false,
                        responsive: true,
                        plugins: {
                            title: { 
                                display: true, 
                                text: "Sales by Payment Method", 
                                color: "#224abe", 
                                font: { size: 16, weight: "bold" } 
                            },
                            legend: { 
                                position: "right", 
                                labels: { color: "#e4e4e4", font: { size: 12 }, boxWidth: 20 } 
                            },
                            tooltip: { backgroundColor: "#333", titleColor: "#e4e4e4", bodyColor: "#e4e4e4" },
                        },
                    },
                });
                console.log("Pie Chart Rendered");
            } else {
                console.warn("Pie Chart: No data or context available");
            }

            // Render Line Chart
            const lineCtx = lineCanvas.getContext("2d");
            if (lineCtx) {
                let lineConfig = {};
                if (filter === "weekly" && currentWeekSales.length > 0 && previousWeekSales.length > 0) {
                    const validCurrentWeekSales = currentWeekSales.map(val => val || 0);
                    const validPreviousWeekSales = previousWeekSales.map(val => val || 0);
                    lineConfig = {
                        type: "line",
                        data: {
                            labels: lineLabels,
                            datasets: [
                                {
                                    label: "Current Week",
                                    data: validCurrentWeekSales,
                                    borderColor: "#224abe",
                                    backgroundColor: "rgba(34, 74, 190, 0.2)",
                                    fill: false,
                                    tension: 0.4,
                                    borderWidth: 2,
                                },
                                {
                                    label: "Previous Week",
                                    data: validPreviousWeekSales,
                                    borderColor: "#46a35e",
                                    backgroundColor: "rgba(70, 163, 94, 0.2)",
                                    fill: false,
                                    tension: 0.4,
                                    borderWidth: 2,
                                },
                            ],
                        },
                        options: {
                            animation: { duration: 1500, easing: "easeInOutQuart" },
                            maintainAspectRatio: false,
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    suggestedMax: Math.max(...validCurrentWeekSales, ...validPreviousWeekSales, 0) * 1.2 || 1000,
                                    title: { display: true, text: "Sales (₹)", color: "#e4e4e4", font: { size: 14 } },
                                    ticks: { color: "#e4e4e4", font: { size: 12 } },
                                    grid: { color: "rgba(255, 255, 255, 0.1)" },
                                },
                                x: {
                                    title: { display: true, text: "Day of Week", color: "#e4e4e4", font: { size: 14 } },
                                    ticks: { color: "#e4e4e4", font: { size: 12 } },
                                    grid: { display: false },
                                },
                            },
                            plugins: {
                                title: { 
                                    display: true, 
                                    text: "Weekly Sales Comparison (Saturday to Friday)", 
                                    color: "#224abe", 
                                    font: { size: 16, weight: "bold" } 
                                },
                                legend: { labels: { color: "#e4e4e4", font: { size: 12 } } },
                                tooltip: { backgroundColor: "#333", titleColor: "#e4e4e4", bodyColor: "#e4e4e4" },
                            },
                        },
                    };
                } else if (lineLabels.length > 0 && lineSales.length > 0) {
                    const validLineSales = lineSales.map(val => val || 0);
                    lineConfig = {
                        type: "line",
                        data: {
                            labels: lineLabels,
                            datasets: [{
                                label: filter === "yearly" ? "Monthly Sales" : "Sales",
                                data: validLineSales,
                                borderColor: "#224abe",
                                backgroundColor: "rgba(34, 74, 190, 0.2)",
                                fill: false,
                                tension: 0.4,
                                borderWidth: 2,
                            }],
                        },
                        options: {
                            animation: { duration: 1500, easing: "easeInOutQuart" },
                            maintainAspectRatio: false,
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    suggestedMax: Math.max(...validLineSales, 0) * 1.2 || 1000,
                                    title: { display: true, text: "Sales (₹)", color: "#e4e4e4", font: { size: 14 } },
                                    ticks: { color: "#e4e4e4", font: { size: 12 } },
                                    grid: { color: "rgba(255, 255, 255, 0.1)" },
                                },
                                x: {
                                    title: {
                                        display: true,
                                        text: filter === "yearly" ? "Month" : (filter === "monthly" ? (lineFilter === "day" ? "Day" : "Week") : "Date"),
                                        color: "#e4e4e4",
                                        font: { size: 14 },
                                    },
                                    ticks: {
                                        color: "#e4e4e4",
                                        font: { size: 12 },
                                        maxRotation: lineFilter === "week" ? 45 : 0,
                                        minRotation: lineFilter === "week" ? 45 : 0,
                                    },
                                    grid: { display: false },
                                },
                            },
                            plugins: {
                                title: {
                                    display: true,
                                    text: filter === "yearly" ? "Yearly Monthly Sales Trend" : 
                                          (filter === "monthly" ? (lineFilter === "day" ? "Monthly Daily Sales" : "Monthly Weekly Sales") : 
                                          "Sales Over Custom Range"),
                                    color: "#224abe",
                                    font: { size: 16, weight: "bold" },
                                },
                                legend: { labels: { color: "#e4e4e4", font: { size: 12 } } },
                                tooltip: { backgroundColor: "#333", titleColor: "#e4e4e4", bodyColor: "#e4e4e4" },
                            },
                        },
                    };
                }
                if (Object.keys(lineConfig).length > 0) {
                    lineChartInstance = new Chart(lineCtx, lineConfig);
                    console.log("Line Chart Rendered");
                } else {
                    console.warn("Line Chart: No valid data available");
                }
            }

            // Check if any chart rendered
            if (!barChartInstance && !pieChartInstance && !lineChartInstance) {
                Swal.fire({
                    icon: 'info',
                    title: 'No Chart Data',
                    text: 'No valid data available to render charts.',
                    confirmButtonColor: '#3085d6',
                });
            }
        }

        document.addEventListener("DOMContentLoaded", async function () {
            const filterSelect = document.getElementById("filter");
            const monthYearSelection = document.getElementById("monthYearSelection");
            const customDateRange = document.getElementById("customDateRange");
            const lineFilterSection = document.getElementById("lineFilterSection");
            const lineFilter = document.getElementById("lineFilter");

            monthYearSelection.style.display = "flex";
            customDateRange.style.display = "none";
            lineFilterSection.style.display = "flex";

            filterSelect.addEventListener("change", function () {
                monthYearSelection.style.display = this.value === "monthly" || this.value === "yearly" ? "flex" : "none";
                customDateRange.style.display = this.value === "custom" ? "flex" : "none";
                lineFilterSection.style.display = this.value === "monthly" ? "flex" : "none";
                if (this.value !== "custom") fetchSalesReport();
            });

            document.getElementById("startDate").addEventListener("change", debounce(() => {
                if (filterSelect.value === "custom") fetchSalesReport();
            }, 300));
            document.getElementById("endDate").addEventListener("change", debounce(() => {
                if (filterSelect.value === "custom") {
                    fetchSalesReport();
                    fetchChartData();
                }
            }, 300));

            lineFilter.addEventListener("change", () => {
                if (filterSelect.value === "monthly") fetchChartData();
            });

            try {
                Swal.fire({
                    title: 'Loading Data...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });
                await Promise.all([fetchSalesReport(), fetchChartData()]);
                Swal.close();
            } catch (error) {
                console.error("Initial Load Error:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to load initial data.',
                    confirmButtonColor: '#d33'
                });
            }
        });
    </script>
</body>
</html>